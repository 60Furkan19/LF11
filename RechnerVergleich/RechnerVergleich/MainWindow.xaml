<Window x:Class="RechnerVergleich.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RechnerVergleich"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="-1,-41,1,41">
        <Label Content="Rechner" HorizontalAlignment="Left" Margin="10,42,0,0" VerticalAlignment="Top" Height="53" Width="122"/>
        <Label Content="Name:" HorizontalAlignment="Left" Margin="33,100,0,0" VerticalAlignment="Top"/>
        <Label Content="IP:" HorizontalAlignment="Left" Margin="55,142,0,0" VerticalAlignment="Top" RenderTransformOrigin="-7.8,-7.757" Height="39" Width="88"/>
        <TextBox HorizontalAlignment="Left" Margin="99,104,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
        <TextBox HorizontalAlignment="Left" Margin="99,144,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
        <TextBlock x:Name="tblprogramme" HorizontalAlignment="Left" Margin="33,209,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Height="114" Width="212"/>
        <Button Content="Hinzufügen" HorizontalAlignment="Left" Margin="250,332,0,0" VerticalAlignment="Top" Height="23" Width="83" Click="btnHinzufuegen"/>
        <TextBox x:Name="tbxProgramme" HorizontalAlignment="Left" Margin="33,332,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="186" Height="20" TextChanged="TextBox_TextChanged_1"/>
        <ComboBox HorizontalAlignment="Left" Margin="491,74,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="ComboBox_SelectionChanged"/>
        <Label Content="Erstellte Rechner" HorizontalAlignment="Left" Margin="491,43,0,0" VerticalAlignment="Top"/>
        <Button Content="Erstellen" HorizontalAlignment="Left" Margin="33,382,0,0" VerticalAlignment="Top" Height="42" Width="93" Click="btnerstellen"/>
        <Button Content="Ändern" HorizontalAlignment="Left" Margin="139,383,0,0" VerticalAlignment="Top" Height="41" Width="80"/>
        <Button Content="Entfernen" HorizontalAlignment="Left" Margin="250,0,0,0" VerticalAlignment="Center" Height="19" Width="83"/>
        <Label Content="Programme:" HorizontalAlignment="Left" Margin="33,179,0,0" VerticalAlignment="Top" Height="25" Width="76"/>

    </Grid>
</Window>
